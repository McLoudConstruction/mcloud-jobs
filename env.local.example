# Copy this file to .env.local for local development.
# In production, set these same two values in Vercel: Project Settings > Environment Variables.
# Find both values in Supabase: Project Settings > API.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional — powers the property name/address autocomplete on the
# Properties form and the Sales > Create Sales Route builder. Without
# it those fields still work as plain text boxes, they just won't
# fetch live listings. See INTEGRATIONS_SETUP.md section 8.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
