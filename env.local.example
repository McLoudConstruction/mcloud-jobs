# Copy this file to .env.local for local development.
# In production, set these same two values in Vercel: Project Settings > Environment Variables.
# Find both values in Supabase: Project Settings > API.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional legacy fallback only — the Google Maps key (address
# autocomplete on Properties and Sales > Create Sales Route) is now
# managed from Settings > Integrations > API keys instead, so nothing
# here needs to change to use or update it. This still works as a
# fallback if you'd rather not use Settings, but Settings takes
# priority when both are set. See INTEGRATIONS_SETUP.md section 8.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
